{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scaylit",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "projet-montage-auto"
    }
  ],
  "containers": [
    {
      "class_name": "ScaylitContainer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "standard-3",
      "max_instances": 25
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCAYLIT_CONTAINER",
        "class_name": "ScaylitContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScaylitContainer"]
    }
  ],
  "vars": {
    "R2_BUCKET_NAME": "projet-montage-auto",
    "R2_ENDPOINT": "https://b51f205e40120277b536ea37083de5f2.r2.cloudflarestorage.com"
  }
}
