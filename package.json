{
  "name": "scaylit",
  "version": "1.0.0",
  "private": true,
  "description": "Scaylit — création et déclinaison de vidéos verticales",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android --variant release --no-bundler",
    "ios": "expo run:ios --configuration Release --no-bundler",
    "ios:dev": "expo run:ios --configuration Debug --port 8082",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "npm run typecheck && node --experimental-strip-types --test tests/*.test.cjs",
    "test:scrap": "node --experimental-strip-types --test tests/scrap.test.cjs && python3 -m unittest discover -s tests -p 'test_scrap_*.py'",
    "export:ios": "expo export --platform ios",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:typecheck": "tsc -p cloudflare/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@expo/vector-icons": "^15.0.2",
    "@napi-rs/canvas": "^0.1.94",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "aws4fetch": "^1.0.20",
    "cloudinary": "^2.0.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.17",
    "expo-build-properties": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.21",
    "expo-keep-awake": "~57.0.2",
    "expo-media-library": "~57.0.6",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "^3.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-zip-archive": "^9.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.128.0"
  }
}
