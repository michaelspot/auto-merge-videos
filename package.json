{
  "name": "scaylit",
  "version": "1.0.0",
  "private": true,
  "description": "Scaylit — création et déclinaison de vidéos verticales",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "npm run typecheck",
    "export:ios": "expo export --platform ios",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:typecheck": "tsc -p cloudflare/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@expo/vector-icons": "^15.0.2",
    "@napi-rs/canvas": "^0.1.94",
    "@react-native-community/slider": "5.2.0",
    "aws4fetch": "^1.0.20",
    "cloudinary": "^2.0.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "^3.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-zip-archive": "^9.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.128.0"
  }
}
